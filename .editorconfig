# EditorConfig — keeps formatting consistent across editors.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{md,markdown}]
# Markdown uses two trailing spaces to force a line break — do not strip them.
trim_trailing_whitespace = false

[*.sql]
indent_size = 4

[*.{yml,yaml,json,jsonc}]
indent_size = 2
