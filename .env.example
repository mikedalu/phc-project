# ──────────────────────────────────────────────────────────────
#  PHC Records — environment template
#  Copy to .env and fill in real values.  NEVER commit .env.
#    cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ─── Environment ───────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=debug

# ─── Server ────────────────────────────────────────────────────
# Cloud Run injects PORT. This default is for LOCAL DEVELOPMENT ONLY.
PORT=8080

# ─── Database ──────────────────────────────────────────────────
# Neon gives you TWO connection strings. They are not interchangeable.
#
#   DATABASE_URL           -> the POOLED endpoint (host contains "-pooler")
#                             Used by the API. Requires QueryExecModeExec
#                             because PgBouncer cannot do prepared statements.
#
#   MIGRATION_DATABASE_URL -> the DIRECT endpoint (no "-pooler")
#                             Used ONLY by goose. Migrations need real
#                             transactions, which transaction pooling breaks.
#
# Get both from: Neon console -> Connection Details
#
# ⚠️  KEEP THE DOUBLE QUOTES. These URLs contain "&" (e.g. channel_binding),
#     and an unquoted "&" makes the shell treat the rest of the line as a
#     background command — the variable silently ends up EMPTY and goose then
#     tries to connect to your local machine instead of Neon. The failure looks
#     like "database ... does not exist", which sends you hunting in the wrong
#     place entirely.
DATABASE_URL=""
MIGRATION_DATABASE_URL=""

# Cloud Run max-instances x DB_MAX_CONNS must stay under your Neon
# plan's connection ceiling. 5 instances x 10 = 50.
DB_MAX_CONNS=10

# ─── Auth ──────────────────────────────────────────────────────
# Generate with:  openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# ─── Offline policy ────────────────────────────────────────────
# How long a workstation may keep working with no server contact.
OFFLINE_GRACE_PERIOD=168h
# What happens once that window expires:
#   block_writes -> stop new writes, keep existing data readable (default, safer)
#   warn_only    -> never block a write; warn persistently instead
OFFLINE_POLICY=block_writes

# ─── Security ──────────────────────────────────────────────────
# Comma-separated CORS allow-list. Must include the Cloudflare Pages
# origin, including preview URLs if you use them.
ALLOWED_ORIGINS=http://localhost:5173
# true when running behind Cloudflare/Cloud Run, so CF-Connecting-IP is read.
TRUST_PROXY=false

# ─── Referrals ─────────────────────────────────────────────────
REFERRAL_TTL_HOURS=48
REFERRAL_PIN_REQUIRED=true
# Generate with:  openssl rand -base64 32
REFERRAL_TOKEN_ENCRYPTION_KEY=

# ─── Sync ──────────────────────────────────────────────────────
SYNC_MAX_BATCH_SIZE=200
SYNC_MAX_BATCH_BYTES=1048576
SYNC_CHANGE_LOG_RETENTION_DAYS=30
