# ─── secrets — never commit ────────────────────────────────────
# ⚠️  `.env` matches at ANY directory level in gitignore, not just the repo root.
#     That would silently exclude web/.env, which holds NON-SECRET build defaults
#     that must be committed (see the note in web/.env). List the secret-bearing
#     files explicitly instead.
#
# ⚠️  `.env.production` is generated by scripts/deploy.sh and is derived from the
#     root .env — so it contains the Neon password, JWT_SECRET and the referral
#     encryption key. It MUST stay ignored. This bit us once already: the pattern
#     list below originally covered only `.env.local`, so `git add -A` would have
#     committed live production credentials.
/.env
/.env.local
/.env.*.local
/.env.production
/.env.staging
/.env.*.production
/api/.env
/api/.env.local
/api/.env.production
.env.local
!.env.example
!web/.env
!web/.env.example

# ─── go ────────────────────────────────────────────────────────
api/bin/
api/tmp/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# ─── node ──────────────────────────────────────────────────────
node_modules/
web/dist/
web/dist-ssr/
web/.vite/
web/coverage/
.pnpm-store/

# ─── playwright / vitest ───────────────────────────────────────
test-results/
playwright-report/
blob-report/
web/test-results/
web/playwright-report/

# ─── data — NEVER commit real patient data ─────────────────────
*.dump
*.sql.gz
*.sqlite
seed-data/real/

# ─── editors / OS ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ─── build / logs ──────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
.turbo/
