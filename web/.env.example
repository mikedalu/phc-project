# ──────────────────────────────────────────────────────────────
#  Frontend build-time configuration
#  Copy to .env.local for local overrides. Never commit .env.local.
#
#  Vite only exposes variables prefixed VITE_ to the browser, and it INLINES
#  them at build time — so never put a secret in this file. Anything here is
#  public the moment it ships.
# ──────────────────────────────────────────────────────────────

# Absolute URL of the API, INCLUDING /api/v1.
#
#   Leave EMPTY for local development. The Vite dev server proxies /api to
#   http://localhost:8080, so the browser sees a single origin and CORS never
#   applies locally. This is the recommended setting.
#
#   In production set it to the Cloud Run service, e.g.
#   VITE_API_URL=https://phc-api-abc123-ew.a.run.app/api/v1
#
# If this is set, the value must be reachable from the browser and its origin
# must also appear in the API's ALLOWED_ORIGINS.
VITE_API_URL=

# Origin only (no path), used to build the Content-Security-Policy connect-src.
#
#   Empty for local development (falls back to same-origin).
#   In production: VITE_API_ORIGIN=https://phc-api-abc123-ew.a.run.app
#
# Getting this wrong does NOT break the build — it breaks at runtime with a CSP
# violation in the console, which is confusing because the same request works
# from curl. That is exactly why it is a separate, explicit variable.
VITE_API_ORIGIN=
