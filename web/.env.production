# ──────────────────────────────────────────────────────────────
#  Production build-time variables for Cloudflare Pages.
#
#  These are NOT secrets — Vite inlines them into the public bundle.
#  They exist so the production build knows where the API lives,
#  since there is no Vite proxy in production.
# ──────────────────────────────────────────────────────────────

# Absolute API URL INCLUDING /api/v1.
VITE_API_URL=https://phc-api-843853811185.europe-west1.run.app/api/v1

# Origin ONLY (no path, no trailing slash) for the CSP connect-src.
# The inner single quotes around 'self' are CSP syntax, not shell quotes.
VITE_API_ORIGIN="'self' https://phc-api-843853811185.europe-west1.run.app"
